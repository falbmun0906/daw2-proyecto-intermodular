# Production Environment Variables - REQUIRED
# Rename to .env.prod and set these values for production deployment

# ===========================
# NEON DATABASE CONFIGURATION (PRODUCTION)
# ===========================
# Obtener credenciales desde: https://console.neon.tech
#
# Connection String completa de Neon (REQUERIDO)
# Formato: jdbc:postgresql://ep-your-project.region.aws.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=jdbc:postgresql://ep-your-production-project.us-east-2.aws.neon.tech/despiensa_prod?sslmode=require

# Credenciales de Neon (REQUERIDAS)
NEON_DB_USER=your-neon-production-username
NEON_DB_PASSWORD=your-neon-production-password

# ===========================
# JWT CONFIGURATION (PRODUCTION)
# ===========================
# IMPORTANTE: Generar un secreto seguro y único
# Generación recomendada: openssl rand -base64 64
JWT_SECRET=your-very-secure-jwt-secret-for-production-change-this

# ===========================
# SPRING ENVIRONMENT
# ===========================
SPRING_PROFILES_ACTIVE=prod

