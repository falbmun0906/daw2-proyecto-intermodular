# Development Environment Variables - Copy this to .env file for local development

# ===========================
# NEON DATABASE CONFIGURATION
# ===========================
# Obtener credenciales desde: https://console.neon.tech
#
# Option 1: Connection String completa (recomendado)
NEON_DATABASE_URL=jdbc:postgresql://ep-example-project-123456.us-east-2.aws.neon.tech/despiensa?sslmode=require

# Option 2: Credenciales individuales (alternativo)
NEON_DB_USER=your-neon-username
NEON_DB_PASSWORD=your-neon-password

# SSL Mode (prefer para desarrollo local, require para producción)
DB_SSL_MODE=prefer

# ===========================
# JWT CONFIGURATION
# ===========================
JWT_SECRET=dGhpc0lzQVZlcnlTZWNyZXRLZXlGb3JKV1RUb2tlbkdlbmVyYXRpb25JblNwcmluZ0Jvb3Q=

# ===========================
# SPRING ENVIRONMENT
# ===========================
SPRING_PROFILES_ACTIVE=dev