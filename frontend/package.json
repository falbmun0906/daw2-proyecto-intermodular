{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "style-guide": "ng serve --open --port 4200 && start http://localhost:4200/style-guide",
    "sg": "npm run style-guide",
    "api": "json-server --watch db.json --port 3000",
    "dev:full": "concurrently \"npm run api\" \"ng serve\"",
    "generate-recipe-variants": "node generate-recipe-variants.js",
    "generate-hero-variants": "node optimize-images.js",
    "generate-all-variants": "npm run generate-hero-variants && npm run generate-recipe-variants",
    "optimize-images": "node optimize-all-images.js",
    "predeploy": "rimraf node_modules/.cache/gh-pages",
    "deploy": "ng deploy --base-href=/daw2-proyecto-intermodular/"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "animejs": "^4.2.2",
    "lucide-angular": "^0.562.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.34.5",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.3.8",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^3.0.2",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.9.0",
    "json-server": "^1.0.0-beta.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rimraf": "^6.1.3",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2"
  }
}
